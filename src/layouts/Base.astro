---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { productos } from '../data/productos';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Datos estructurados extra de la página (FAQPage, ItemList, etc.) */
  schema?: Record<string, unknown>[];
}

const { title, description = site.descripcion, image = '/img/vastago-despues.jpg', schema: extra = [] } = Astro.props;
const fullTitle = title ? `${title} | ECODUR` : 'ECODUR | Recubrimientos industriales y metalización en Olavarría';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const home = Astro.site!.toString();

// Ficha de la empresa para buscadores y asistentes de IA (schema.org).
const empresa = {
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${home}#empresa`,
  name: 'ECODUR',
  legalName: site.nombre,
  description: site.descripcion,
  url: home,
  logo: new URL('/favicon.svg', Astro.site).href,
  image: new URL('/img/taller-torno.jpg', Astro.site).href,
  email: site.emails[0],
  ...(site.telefono ? { telephone: site.telefono } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.direccion,
    addressLocality: 'Olavarría',
    addressRegion: 'Buenos Aires',
    addressCountry: 'AR',
  },
  contactPoint: site.emails.map((e) => ({ '@type': 'ContactPoint', contactType: 'ventas y consultas técnicas', email: e, availableLanguage: 'es' })),
  knowsAbout: [
    'Metalización por proyección térmica',
    'HVOF',
    'Reemplazo de cromo duro',
    'Hardfacing',
    'Soldaduras especiales',
    'Recuperación dimensional de piezas',
    'Recubrimientos antidesgaste',
    'Recubrimientos anticorrosivos',
    'Carburo de tungsteno',
    'Carburo de cromo',
    'Re-babbitado con metal blanco',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios y líneas de recubrimiento',
    itemListElement: productos.map((p) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: p.nombre, description: `${p.uso}. ${p.descripcion}`, url: `${home}productos#${p.id}` },
    })),
  },
};

const graph = { '@context': 'https://schema.org', '@graph': [empresa, ...extra] };
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="ECODUR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <link rel="alternate" type="text/markdown" href="/llms.txt" title="Resumen de ECODUR para asistentes de IA" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
