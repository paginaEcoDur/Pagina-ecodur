---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import { sectoresConFotos, type SectorConFotos } from '../../lib/galerias';
import { trabajos } from '../../data/trabajos';

// Se genera una página solo para los sectores que tienen fotos.
export function getStaticPaths() {
  return sectoresConFotos.filter((s) => s.fotos.length).map((s) => ({ params: { sector: s.carpeta }, props: { s } }));
}

const { s } = Astro.props as { s: SectorConFotos };
const relacionados = trabajos.filter((t) => s.trabajos?.includes(t.id));
const otros = sectoresConFotos.filter((o) => o.url && o.carpeta !== s.carpeta);

// Versión grande de cada foto para el visor (sin agrandar más que el original).
const grandes = await Promise.all(
  s.fotos.map((f) => getImage({ src: f.src, width: Math.min(f.src.width, 1600), format: 'webp' })),
);
const portada = await getImage({ src: s.fotos[0].src, width: Math.min(s.fotos[0].src.width, 1200), format: 'jpg' });
---
<Base
  title={`${s.nombre}: trabajos y fotos`}
  description={s.texto ?? `Trabajos de ECODUR para el sector ${s.nombre}: recubrimientos, reparación y recuperación de piezas.`}
  image={portada.src}
>
  <div class="wrap page-head">
    <p class="volver"><a href="/empresa#sectores">Sectores que atendemos</a></p>
    <h1>{s.nombre}</h1>
    {s.texto && <p class="lead">{s.texto}</p>}
  </div>

  <section class="wrap galeria-sec" aria-label={`Fotos de ${s.nombre}`}>
    <ul class="galeria">
      {s.fotos.map((f, i) => (
        <li>
          <button type="button" class="galeria__item" data-i={i} aria-label={`Ampliar: ${f.alt}`}>
            <Image src={f.src} alt={f.alt} widths={[400, 800]} sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw" loading={i < 3 ? 'eager' : 'lazy'} />
          </button>
          <p class="galeria__pie">{f.alt}</p>
        </li>
      ))}
    </ul>
  </section>

  {relacionados.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="sub">Trabajos de este sector</h2>
        <ul class="ticks relacionados">
          {relacionados.map((t) => <li><a href={`/trabajos#${t.id}`}>{t.titulo}</a> <span class="muted">({t.linea})</span></li>)}
        </ul>
      </div>
    </section>
  )}

  {otros.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="sub">Otros sectores</h2>
        <ul class="otros">
          {otros.map((o) => <li><a href={o.url!}>{o.nombre}</a></li>)}
        </ul>
      </div>
    </section>
  )}

  <CtaBand />

  <dialog class="visor" aria-label="Foto ampliada">
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="visor__btn visor__cerrar" aria-label="Cerrar">✕</button>
    {s.fotos.length > 1 && (
      <>
        <button type="button" class="visor__btn visor__ant" aria-label="Foto anterior">‹</button>
        <button type="button" class="visor__btn visor__sig" aria-label="Foto siguiente">›</button>
      </>
    )}
  </dialog>
  <script type="application/json" id="fotos" set:html={JSON.stringify(s.fotos.map((f, i) => ({ src: grandes[i].src, alt: f.alt })))} />
</Base>

<script>
  const fotos: { src: string; alt: string }[] = JSON.parse(document.getElementById('fotos')?.textContent ?? '[]');
  const visor = document.querySelector<HTMLDialogElement>('.visor');
  const img = visor?.querySelector('img');
  const pie = visor?.querySelector('figcaption');
  let actual = 0;

  function mostrar(i: number) {
    if (!img || !pie) return;
    actual = (i + fotos.length) % fotos.length;
    img.src = fotos[actual].src;
    img.alt = fotos[actual].alt;
    pie.textContent = `${fotos[actual].alt} (${actual + 1} de ${fotos.length})`;
  }

  document.querySelectorAll<HTMLButtonElement>('.galeria__item').forEach((b) =>
    b.addEventListener('click', () => {
      mostrar(Number(b.dataset.i));
      visor?.showModal();
    }),
  );
  visor?.querySelector('.visor__cerrar')?.addEventListener('click', () => visor.close());
  visor?.querySelector('.visor__ant')?.addEventListener('click', () => mostrar(actual - 1));
  visor?.querySelector('.visor__sig')?.addEventListener('click', () => mostrar(actual + 1));
  visor?.addEventListener('click', (e) => {
    if (e.target === visor) visor.close();
  });
  visor?.addEventListener('keydown', (e) => {
    if (fotos.length < 2) return;
    if (e.key === 'ArrowLeft') mostrar(actual - 1);
    if (e.key === 'ArrowRight') mostrar(actual + 1);
  });
</script>

<style>
  .volver {
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .volver a::before {
    content: '‹ ';
  }

  .galeria-sec {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .galeria {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 1rem;
  }

  .galeria__item {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--plate);
    cursor: zoom-in;
  }

  .galeria__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .galeria__item:hover img {
    transform: scale(1.03);
  }

  .galeria__pie {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--steel);
  }

  .sub {
    font-size: var(--step-2);
    margin-bottom: 1.25rem;
  }

  .relacionados a {
    font-weight: 600;
  }

  .otros {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .otros a {
    display: inline-block;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    font-weight: 600;
  }

  .otros a:hover {
    border-color: var(--red);
  }

  .visor {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(20 24 27 / 0.94);
    color: #fff;
  }

  .visor::backdrop {
    background: transparent;
  }

  .visor figure {
    height: 100%;
    margin: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 4rem 4.5rem 2rem;
  }

  .visor img {
    max-width: 100%;
    max-height: calc(100vh - 9rem);
    border-radius: var(--radius);
  }

  .visor figcaption {
    color: #cfd4d7;
    font-size: var(--step--1);
    text-align: center;
  }

  .visor__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: var(--radius);
    background: rgb(0 0 0 / 0.35);
    color: #fff;
    font: inherit;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }

  .visor__btn:hover {
    border-color: #fff;
  }

  .visor__cerrar {
    top: 1rem;
    right: 1rem;
    font-size: 1.2rem;
  }

  .visor__ant,
  .visor__sig {
    top: 50%;
    transform: translateY(-50%);
  }

  .visor__ant {
    left: 1rem;
  }

  .visor__sig {
    right: 1rem;
  }

  @media (max-width: 64rem) {
    .galeria {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .galeria {
      grid-template-columns: 1fr;
    }
    .visor figure {
      padding: 4rem 0.75rem 5rem;
    }
    .visor__ant,
    .visor__sig {
      top: auto;
      bottom: 1rem;
      transform: none;
    }
  }
</style>
