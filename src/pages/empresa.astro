---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { Image } from 'astro:assets';
import { sectoresConFotos } from '../lib/galerias';

const pilares = [
  {
    titulo: 'Equipos de primeras marcas',
    texto:
      'Trabajamos con equipos de las marcas líderes del mercado, con instalaciones pensadas para procesos repetibles y controlados.',
  },
  {
    titulo: 'Personal capacitado',
    texto:
      'Nuestro equipo técnico recibe capacitación y soporte continuo de los representantes locales de esas marcas, para estar al día con cada proceso.',
  },
  {
    titulo: 'Conocimiento de cada aplicación',
    texto:
      'Conocemos cómo trabajan las piezas en los principales sectores industriales. Eso nos permite elegir el recubrimiento correcto para cada caso.',
  },
];
---
<Base title="Empresa" description="ECODUR S.A.: más de 12 años en metalización por proyección térmica, soldaduras especiales y hardfacing. Planta de 650 m² en el Parque Industrial de Olavarría.">
  <div class="wrap page-head">
    <h1>Nuestra empresa</h1>
    <p class="lead">
      Hace más de 12 años que reparamos y fabricamos componentes mecánicos en el mercado metalúrgico,
      con metalización por proyección, soldaduras especiales y hardfacing.
    </p>
  </div>

  <section class="wrap intro">
    <div class="photo intro__photo">
      <img src="/img/taller-torno.jpg" alt="Personal de Ecodur trabajando en el torno de gran porte" width="1024" height="576" />
    </div>
    <div class="intro__text">
      <h2>Valor agregado sobre cada pieza</h2>
      <p>
        Nuestra propuesta es simple: tomar un componente gastado, o fabricar uno nuevo, y aplicarle el recubrimiento
        que lo haga durar más. Trabajamos con recubrimientos metálicos, no metálicos, cerámicos y cermet.
      </p>
      <p>
        La planta, de 650 m² cubiertos, está en el Parque Industrial de Olavarría. La combinación del nivel técnico
        de nuestro equipo, la fiabilidad de los equipos y el conocimiento de las aplicaciones de los principales
        sectores industriales hace de ECODUR una de las mejores opciones del mercado local.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2>Por qué ECODUR</h2>
      </div>
      <div class="pilares">
        {pilares.map((p) => (
          <article>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="sectores">
    <div class="wrap">
      <div class="section__head">
        <h2>Sectores que atendemos</h2>
        <p class="lead">Nuestros recubrimientos se usan en industrias donde una pieza parada cuesta caro.</p>
      </div>
      <ul class="sectores">
        {sectoresConFotos.map((s) => (
          <li class:list={['sector', { 'sector--sin-foto': !s.url }]}>
            {s.url ? (
              <a href={s.url} class="sector__link">
                <Image src={s.fotos[0].src} alt="" widths={[320, 640]} sizes="(max-width: 64rem) 50vw, 20vw" loading="lazy" />
                <span class="sector__nombre">{s.nombre}</span>
                <span class="sector__cant">{s.fotos.length === 1 ? '1 foto' : `${s.fotos.length} fotos`}</span>
              </a>
            ) : (
              <span class="sector__nombre">{s.nombre}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }

  .intro__photo {
    aspect-ratio: 16 / 10;
  }

  .intro__text {
    display: grid;
    gap: 1.1rem;
  }

  .intro__text h2 {
    margin-bottom: 0.25rem;
  }

  .pilares {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .pilares article {
    border-top: 2px solid var(--ink);
    padding-top: 1.25rem;
  }

  .pilares p {
    margin-top: 0.9rem;
    color: var(--steel);
  }

  .sectores {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .sector {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--graphite);
    border-bottom: 4px solid var(--red);
  }

  .sector__link {
    display: block;
    height: 100%;
    color: #fff;
    text-decoration: none;
  }

  .sector img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .sector__link:hover img {
    transform: scale(1.04);
  }

  .sector__link:focus-visible {
    outline-offset: -3px;
  }

  .sector__cant {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 1;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius);
    background: rgb(28 33 37 / 0.75);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .sector::after {
    content: '';
    position: absolute;
    inset: 40% 0 0 0;
    background: linear-gradient(to bottom, rgb(28 33 37 / 0), rgb(28 33 37 / 0.85));
  }

  .sector--sin-foto::after {
    display: none;
  }

  .sector__nombre {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.85rem;
    z-index: 1;
    color: #fff;
    font-stretch: var(--narrow);
    font-weight: 800;
    font-size: var(--step-1);
    line-height: 1.05;
  }

  @media (max-width: 64rem) {
    .sectores {
      grid-template-columns: repeat(2, 1fr);
    }
    .sector__nombre {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.65rem;
    }
  }

  @media (max-width: 56rem) {
    .intro {
      grid-template-columns: 1fr;
    }
    .pilares {
      grid-template-columns: 1fr;
    }
  }

</style>
