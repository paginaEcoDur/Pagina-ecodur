---
import { site } from '../data/site';
interface Props { title?: string; text?: string }
const {
  title = '¿Tiene una pieza gastada?',
  text = 'Mándenos fotos, medidas y una descripción del servicio que cumple. Le respondemos con el diagnóstico y la solución que recomendamos.',
} = Astro.props;
---
<section class="cta">
  <div class="wrap cta__inner">
    <div class="cta__text">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn" href="/contacto">Pedir una consulta</a>
      <a class="btn btn--light" href={`mailto:${site.emails[0]}`}>Escribir a {site.emails[0]}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--ink);
    color: #fff;
    padding-block: clamp(3rem, 7vw, 5rem);
    border-top: 4px solid var(--red);
  }

  .cta__inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem 3rem;
    align-items: end;
  }

  .cta__text p {
    margin-top: 1rem;
    color: #cfd4d7;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-end;
  }

  .cta__actions .btn {
    overflow-wrap: anywhere;
  }

  @media (max-width: 52rem) {
    .cta__inner {
      grid-template-columns: 1fr;
    }
    .cta__actions {
      justify-content: flex-start;
    }
  }
</style>
